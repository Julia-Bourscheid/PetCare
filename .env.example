# Supabase > Connect > Session pooler.
# A conexão direta (db.<project-ref>.supabase.co) só tem IPv6 e não funciona
# em redes sem IPv6 nem na Vercel.
DATABASE_URI=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Use "false" para bancos locais sem SSL (ex.: Postgres no Docker).
# DATABASE_SSL=false

# Microsoft Clarity > Settings > Overview > Project ID.
# Sem valor, nem o Clarity nem o aviso de cookies são carregados.
# CLARITY_PROJECT_ID=
